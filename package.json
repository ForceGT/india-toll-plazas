{
  "name": "india-toll-plazas",
  "version": "1.0.0",
  "description": "Open India toll plaza JSON dataset: NHAI RajMargyatra national highways + state highways, coordinates, vehicle toll rates (FASTag classes), monthly snapshots & releases.",
  "main": "fetch-and-process.sh",
